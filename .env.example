NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Evolution API (somente no servidor)
EVOLUTION_API_KEY=
# O endereço e a instância também podem ser configurados na tela Configurações.
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=

# OpenAI: opcional. A chave pode ser cadastrada com segurança em Configurações > OpenAI.
# Se definida aqui, a variável de ambiente tem prioridade sobre a chave salva no Vault.
OPENAI_API_KEY=
OPENAI_INVOICE_MODEL=

# Protege a rota executada pelo agendador
CRON_SECRET=
